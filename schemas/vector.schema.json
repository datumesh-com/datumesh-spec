{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datumesh.com/schemas/1/vector.schema.json",
  "title": "Datumesh test vector",
  "description": "The format of every file under vectors/ (SPEC.md section 11).",
  "type": "object",
  "required": [
    "id",
    "kind",
    "description",
    "valid"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "jcs",
        "scalar",
        "cell",
        "ref",
        "function",
        "uri",
        "keyid",
        "keys",
        "receipt",
        "unit",
        "envelope",
        "slice",
        "formula",
        "formula-eval",
        "excel",
        "decimal",
        "mesh"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "valid": {
      "type": "boolean"
    },
    "input": {
      "type": "string"
    },
    "input_hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    },
    "error": {
      "type": "string",
      "pattern": "^E_[A-Z_]+$"
    },
    "canonical": {
      "type": "string"
    },
    "sha256": {
      "$ref": "defs.schema.json#/$defs/hex64"
    },
    "object": {
      "$ref": "cell-ref.schema.json"
    },
    "https": {
      "type": "string",
      "pattern": "^https://"
    },
    "signature": {
      "description": "The function signature parse uses; normally an object, deliberately malformed in some invalid vectors."
    },
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "key_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "host": {
      "type": "string",
      "description": "The host keys (keys vectors) or the mesh (mesh vectors) are resolved for; a DNS name except in invalid vectors that test that rule."
    },
    "env": {
      "type": "object",
      "description": "A key environment (keys vectors); for mesh vectors (spec-0.4.1) {keys, mesh}, each the HTTPS result for one document; or a formula vector's environment: name, signature, functions, aliases."
    },
    "keypair": {
      "type": "object",
      "required": [
        "seed",
        "public",
        "key_id"
      ],
      "properties": {
        "seed": {
          "$ref": "defs.schema.json#/$defs/hex64"
        },
        "public": {
          "$ref": "defs.schema.json#/$defs/hex64"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      }
    },
    "keys": {
      "type": "object"
    },
    "sig": {
      "$ref": "defs.schema.json#/$defs/hex128"
    },
    "level": {
      "enum": [
        "signed",
        "recomputed"
      ]
    },
    "recompute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "descriptor": {},
        "value": {
          "type": "object"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Receipt hash to receipt JSON text. Entries are always strings (RS-29)."
        },
        "manifests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "spec-0.4.0: slice entry to manifest JSON text."
        },
        "lineage": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/inputEntry"
          },
          "description": "spec-0.4.0: the inputs entries the evaluation read (for E_INPUT_SUPERSEDED)."
        }
      }
    },
    "blob_hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    },
    "status": {
      "description": "An HTTP status, or for an excel vector its status in the table.",
      "type": [
        "integer",
        "string"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": "string"
    },
    "trust": {
      "enum": [
        "primary",
        "verified",
        "unverified"
      ]
    },
    "receipt_hash": {
      "$ref": "defs.schema.json#/$defs/hex64"
    },
    "request": {
      "type": "object",
      "required": [
        "cell_id"
      ],
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "$ref": "defs.schema.json#/$defs/hex64"
        },
        "asof": {
          "$ref": "defs.schema.json#/$defs/instant"
        },
        "job": {
          "type": "string",
          "pattern": "^[0-9a-f]{32,64}$",
          "description": "spec-0.4.1: the envelope is the response to GET /jobs/<job> for this original request."
        }
      }
    },
    "blob_checked": {
      "type": "boolean"
    },
    "code": {
      "description": "A code reported with success (SPEC.md 11), on a valid receipt vector at level signed: E_EVAL_UNAVAILABLE, or E_INPUT_SUPERSEDED (spec-0.4.0).",
      "enum": [
        "E_EVAL_UNAVAILABLE",
        "E_INPUT_SUPERSEDED"
      ]
    },
    "token": {
      "type": "string",
      "description": "For E_FORMULA_FORBIDDEN: the forbidden name as written."
    },
    "slice_id": {
      "$ref": "defs.schema.json#/$defs/hex64"
    },
    "members_hash": {
      "$ref": "defs.schema.json#/$defs/hex64"
    },
    "entry": {
      "$ref": "defs.schema.json#/$defs/sliceEntry"
    },
    "ast": {
      "type": "string"
    },
    "ast_sha256": {
      "$ref": "defs.schema.json#/$defs/hex64"
    },
    "body": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/functionName"
      },
      "description": "For formula vectors: the derived inputs."
    },
    "returns": {
      "type": "object"
    },
    "asof_dependent": {
      "type": "boolean"
    },
    "value": {
      "$ref": "defs.schema.json#/$defs/scalar"
    },
    "lineage": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/inputEntry"
      }
    },
    "tx": {
      "$ref": "defs.schema.json#/$defs/instant"
    },
    "receipt_asof": {
      "$ref": "defs.schema.json#/$defs/instant"
    },
    "fuel_used": {
      "type": "integer",
      "minimum": 0
    },
    "fuel": {
      "type": "integer",
      "minimum": 0
    },
    "world": {
      "type": "object",
      "required": [
        "functions",
        "receipts"
      ],
      "properties": {
        "functions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "bound",
              "descriptor"
            ],
            "properties": {
              "bound": {
                "$ref": "defs.schema.json#/$defs/instant"
              },
              "descriptor": {
                "$ref": "function.schema.json"
              }
            }
          }
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "receipt.schema.json"
          }
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "args",
        "fn"
      ],
      "properties": {
        "fn": {
          "$ref": "defs.schema.json#/$defs/functionName"
        },
        "args": {
          "$ref": "defs.schema.json#/$defs/args"
        }
      }
    },
    "asof": {
      "$ref": "defs.schema.json#/$defs/instant"
    },
    "excel": {
      "type": "string"
    },
    "doc": {
      "type": "string",
      "pattern": "^https://support\\.microsoft\\.com/"
    },
    "documentation_derived": {
      "const": true
    },
    "sample": {
      "type": "string"
    },
    "excel_result": {
      "$ref": "defs.schema.json#/$defs/scalar"
    },
    "formula": {
      "type": "string"
    },
    "op": {
      "enum": [
        "add",
        "sub",
        "mul",
        "div",
        "power",
        "sqrt",
        "exp",
        "ln",
        "pow",
        "sin",
        "cos",
        "atan2",
        "haversine",
        "sum",
        "mean",
        "median",
        "stdev",
        "stdev_p",
        "round",
        "mod"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mpdecimal": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "hard_cases": {
      "type": "integer",
      "minimum": 0
    },
    "bindings": {
      "type": "string",
      "pattern": "^https://",
      "description": "spec-0.4.1, mesh vectors: the bindings URL."
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https://"
      },
      "description": "spec-0.4.1, mesh vectors: the known endpoint templates; unknown members are dropped."
    }
  },
  "oneOf": [
    {
      "required": [
        "input"
      ]
    },
    {
      "required": [
        "input_hex"
      ]
    },
    {
      "properties": {
        "kind": {
          "enum": [
            "keys",
            "mesh",
            "formula-eval",
            "excel",
            "decimal"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "input_hex"
            ]
          }
        ]
      }
    }
  ],
  "if": {
    "properties": {
      "valid": {
        "const": false
      }
    }
  },
  "then": {
    "required": [
      "error"
    ]
  },
  "else": {
    "not": {
      "required": [
        "error"
      ]
    }
  },
  "dependentSchemas": {
    "code": {
      "properties": {
        "kind": {
          "const": "receipt"
        },
        "valid": {
          "const": true
        },
        "level": {
          "const": "signed"
        }
      },
      "required": [
        "level"
      ]
    }
  }
}
