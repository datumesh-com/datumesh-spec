    "unitArg": {
      "type": "object",
      "required": [
        "arg"
      ],
      "additionalProperties": false,
      "properties": {
        "arg": {
          "$ref": "#/$defs/argName"
        }
      }
    },
    "unit": {
      "description": "A unit in a signature (SPEC.md 7.1). That an argument reference names a string argument is checked by the verification procedure.",
      "anyOf": [
        {
          "$ref": "#/$defs/unitLiteral"
        },
        {
          "$ref": "#/$defs/unitArg"
        },
        {
          "type": "object",
          "required": [
            "of",
            "per"
          ],
          "additionalProperties": false,
          "properties": {
            "of": {
              "anyOf": [
                {
                  "$ref": "#/$defs/currency"
                },
                {
                  "$ref": "#/$defs/unitArg"
                }
              ]
            },
            "per": {
              "anyOf": [
                {
                  "$ref": "#/$defs/currency"
                },
                {
                  "$ref": "#/$defs/unitArg"
                }
              ]
            }
          }
        }
      ]
    },
    "sliceEntry": {
      "description": "A slice-as-lineage entry (SPEC.md 15.13): slice:<slice id>:<members hash>.",
      "type": "string",
      "pattern": "^slice:[0-9a-f]{64}:[0-9a-f]{64}$"
    },
    "inputEntry": {
      "description": "An inputs entry: a receipt hash or a slice entry.",
      "anyOf": [
        {
          "$ref": "#/$defs/hex64"
        },
        {
          "$ref": "#/$defs/sliceEntry"
        }
      ]
    },
    "rangeObject": {
      "description": "A range in a slice object (SPEC.md 15.13): inclusive ends in the type's lexical form.",
      "type": "object",
      "required": [
        "hi",
        "lo",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "hi": {
          "type": "string"
        },
        "lo": {
          "type": "string"
        },
        "type": {
          "enum": [
            "date",
            "instant",
            "number",
            "string"
          ]
        }
      }
