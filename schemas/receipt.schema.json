{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datumesh.com/schemas/1/receipt.schema.json",
  "title": "Datumesh receipt",
  "description": "A signed answer for one cell (SPEC.md section 8). The receipt hash is SHA-256 over the JCS of the receipt without sig; sig is Ed25519 over the same bytes.",
  "type": "object",
  "required": [
    "asof",
    "cell",
    "computed_by",
    "inputs",
    "issued",
    "licence",
    "proto",
    "publisher",
    "sig",
    "summary",
    "tx",
    "type",
    "valid",
    "value"
  ],
  "additionalProperties": false,
  "properties": {
    "asof": {
      "$ref": "defs.schema.json#/$defs/instant",
      "description": "Transaction time the value was served as of."
    },
    "cell": {
      "type": "object",
      "required": [
        "args",
        "fn",
        "fn_hash",
        "ns"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "defs.schema.json#/$defs/args"
        },
        "fn": {
          "$ref": "defs.schema.json#/$defs/name"
        },
        "fn_hash": {
          "$ref": "defs.schema.json#/$defs/hex64"
        },
        "ns": {
          "$ref": "defs.schema.json#/$defs/namespace"
        }
      }
    },
    "computed_by": {
      "$ref": "defs.schema.json#/$defs/keyRef",
      "description": "<host>#<key id> of the key that signed this receipt."
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4096,
      "items": {
        "$ref": "defs.schema.json#/$defs/inputEntry"
      },
      "description": "Receipt hashes of the inputs and, since spec-0.4.0, slice entries slice:<slice id>:<members hash>; ascending, each one entry. Empty for stored cells."
    },
    "issued": {
      "$ref": "defs.schema.json#/$defs/instant",
      "description": "When the receipt was signed; key validity is checked against it."
    },
    "licence": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$",
          "maxLength": 64
        },
        {
          "pattern": "^https://[!-~]+$",
          "maxLength": 512
        },
        {
          "pattern": "^public:https://[!-~]+$",
          "maxLength": 512
        }
      ]
    },
    "proto": {
      "const": "datumesh/1"
    },
    "publisher": {
      "$ref": "defs.schema.json#/$defs/namespace"
    },
    "sig": {
      "$ref": "defs.schema.json#/$defs/hex128"
    },
    "summary": {
      "$ref": "defs.schema.json#/$defs/string",
      "minLength": 1
    },
    "tx": {
      "$ref": "defs.schema.json#/$defs/instant",
      "description": "Transaction time the value was recorded."
    },
    "type": {
      "$ref": "defs.schema.json#/$defs/type"
    },
    "valid": {
      "$ref": "defs.schema.json#/$defs/args",
      "description": "The valid-time arguments of cell.args, echoed."
    },
    "value": {
      "type": [
        "string",
        "boolean"
      ]
    },
    "source": {
      "description": "spec-0.6.0 (C2, 8.1): a stored receipt's provenance for a relayed value. Only when inputs is empty (checked here by if/then); the rules of 8.1 are checked by the procedure, in member order.",
      "type": "object",
      "required": [
        "name",
        "retrieved",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "defs.schema.json#/$defs/dnsName",
          "description": "The source's DNS name; not the host of cell.ns (checked by the procedure, E_SCHEMA)."
        },
        "retrieved": {
          "$ref": "defs.schema.json#/$defs/instant",
          "description": "When the publisher fetched the value; at or before issued (8.2)."
        },
        "url": {
          "type": "string",
          "pattern": "^https://[!-~]+$",
          "maxLength": 512,
          "description": "Where the value was taken from: https://, printable ASCII, at most 512 characters."
        },
        "sha256": {
          "$ref": "defs.schema.json#/$defs/hex64",
          "description": "The SHA-256 of the bytes fetched from url."
        },
        "takeover": {
          "type": "string",
          "pattern": "^https://[!-~]+$",
          "maxLength": 512,
          "description": "Where the source can take over publishing these cells."
        }
      }
    }
  },
  "$ref": "defs.schema.json#/$defs/typedValue",
  "allOf": [
    {
      "if": {
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
