{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datumesh.com/schemas/1/envelope.schema.json",
  "title": "Datumesh response envelope",
  "description": "The JSON body a mesh returns at https://<mesh>/cell/<rest> (SPEC.md 5.5). Not hashed, not signed: the mesh's statement. Only the embedded receipt is verifiable. The HTTP status must match outcome; that, and trust: primary against the receipt, are checked by the procedure in 5.5. The receipt must also answer the request (step 5), which the body does not contain; a pending envelope (spec-0.4.1) echoes the request, and the envelope served at its poll URL is checked against that original request. Since spec-0.4.2: trust computed, the fn_hash echo, not_covered with E_NAME_UNBOUND, and the slice endpoint's page (5.6): an ok envelope with slice, members (ok or stale envelopes) and next. Since spec-0.4.3: E_FOREIGN_UNAVAILABLE (error, 502) with detail. Since spec-0.5.0: resolved and shadows (16.7, 16.9), E_SHORT_ID_AMBIGUOUS, E_KEY_NORMALISATION and E_KEY_ENCODING for bad_request.",
  "type": "object",
  "required": [
    "outcome"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "ok",
        "stale",
        "not_covered",
        "unlicensed",
        "payment_required",
        "rate_limited",
        "error",
        "bad_request",
        "pending"
      ]
    },
    "receipt": {
      "$ref": "receipt.schema.json"
    },
    "trust": {
      "enum": [
        "primary",
        "verified",
        "unverified",
        "computed"
      ]
    },
    "age_seconds": {
      "$ref": "#/$defs/seconds"
    },
    "superseded_by": {
      "$ref": "defs.schema.json#/$defs/hex64"
    },
    "reason": {
      "$ref": "defs.schema.json#/$defs/string",
      "minLength": 1
    },
    "quote": {
      "type": "object",
      "required": [
        "amount",
        "authorise",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "defs.schema.json#/$defs/number",
          "not": {
            "pattern": "^(-|0$)"
          }
        },
        "authorise": {
          "type": "string",
          "pattern": "^https://[!-~]+$",
          "maxLength": 512
        },
        "currency": {
          "$ref": "defs.schema.json#/$defs/currency"
        }
      }
    },
    "retry_after_seconds": {
      "$ref": "#/$defs/seconds"
    },
    "estimate_seconds": {
      "$ref": "#/$defs/seconds",
      "description": "For pending (spec-0.4.1): the mesh's estimate of the seconds until the job's result is ready."
    },
    "job": {
      "type": "string",
      "pattern": "^[0-9a-f]{32,64}$",
      "description": "For pending (spec-0.4.1): the job id, at least 128 bits from a CSPRNG, as lowercase hex (SPEC.md 5.5)."
    },
    "poll": {
      "type": "string",
      "maxLength": 512,
      "description": "For pending: the URL of the job, https://, a DNS name (no port, no userinfo), then a path ending /jobs/<job> with this envelope's job (checked by the procedure in 5.5). Whether the host is the one asked is the client's check. Since spec-0.5.0 also a loopback http URL, accepted only for a request naming an unrooted mesh (checked by the procedure).",
      "anyOf": [
        {
          "pattern": "^https://[a-z0-9-]+(\\.[a-z0-9-]+)+/([!-~]*/)?jobs/[0-9a-f]{32,64}$"
        },
        {
          "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]|localhost)(:[1-9][0-9]{0,4})?/([!-~]*/)?jobs/[0-9a-f]{32,64}$"
        }
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "cell_id"
      ],
      "additionalProperties": false,
      "description": "For pending: the original request, echoed (fn_hash when it was pinned, since spec-0.4.2).",
      "properties": {
        "cell_id": {
          "$ref": "defs.schema.json#/$defs/hex64"
        },
        "asof": {
          "$ref": "defs.schema.json#/$defs/instant"
        },
        "fn_hash": {
          "$ref": "defs.schema.json#/$defs/hex64"
        }
      }
    },
    "fn_hash": {
      "$ref": "defs.schema.json#/$defs/hex64",
      "description": "spec-0.4.2: the function hash of the answer; required when the request pinned one (except rate_limited, bad_request and pending, whose request echoes it)."
    },
    "slice": {
      "type": "object",
      "description": "spec-0.4.2, slice pages: the slice object (SPEC.md 4.4) whose id was requested."
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#",
        "properties": {
          "outcome": {
            "enum": [
              "ok",
              "stale"
            ]
          }
        }
      },
      "description": "spec-0.4.2, slice pages: member envelopes in ascending key order."
    },
    "next": {
      "type": "string",
      "maxLength": 512,
      "description": "spec-0.4.2, slice pages: the URL of the following page, on the mesh's host; absent on the last page. Since spec-0.5.0 also a loopback http URL, for a request naming an unrooted mesh.",
      "anyOf": [
        {
          "pattern": "^https://[a-z0-9-]+(\\.[a-z0-9-]+)+/"
        },
        {
          "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]|localhost)(:[1-9][0-9]{0,4})?/"
        }
      ]
    },
    "error": {
      "enum": [
        "E_PARSE_JSON",
        "E_PARSE_DUPLICATE_KEY",
        "E_PARSE_URI",
        "E_SCHEMA",
        "E_CANON_NAME",
        "E_CANON_ARG_NAME",
        "E_CANON_ARG_DUPLICATE",
        "E_CANON_ARG_ORDER",
        "E_CANON_PERCENT",
        "E_CANON_TYPE",
        "E_CANON_NUMBER",
        "E_CANON_UNIT",
        "E_CANON_DATE",
        "E_CANON_INSTANT",
        "E_CANON_STRING",
        "E_CANON_BLOB",
        "E_CANON_HEX",
        "E_CANON_LICENCE",
        "E_CANON_SET",
        "E_CANON_LIMIT",
        "E_SLICE",
        "E_PUBLISHER_MISMATCH",
        "E_VALID_MISMATCH",
        "E_TIME_ORDER",
        "E_ARG_UNKNOWN",
        "E_ARG_MISSING",
        "E_KEY_UNAVAILABLE",
        "E_KEY_DOC",
        "E_KEY_UNKNOWN",
        "E_KEY_NOT_VALID",
        "E_SIGNATURE",
        "E_FN_UNAVAILABLE",
        "E_FN_HASH_MISMATCH",
        "E_ARG_TYPE",
        "E_RETURN_TYPE",
        "E_INPUT_UNAVAILABLE",
        "E_INPUT_INVALID",
        "E_INPUT_UNDECLARED",
        "E_SLICE_MEMBER",
        "E_VALUE_MISMATCH",
        "E_EVAL_UNAVAILABLE",
        "E_INPUT_SUPERSEDED",
        "E_BLOB_MISMATCH",
        "E_JOB_UNKNOWN",
        "E_MESH_DOC",
        "E_SLICE_AT_CELL",
        "E_NAME_UNBOUND",
        "E_FOREIGN_UNAVAILABLE",
        "E_SHORT_ID_AMBIGUOUS",
        "E_NAMESPACE_SUSPENDED",
        "E_KEY_NORMALISATION",
        "E_KEY_ENCODING"
      ],
      "description": "A code from SPEC.md 10.2 other than E_ENVELOPE; for bad_request, a URI parse code (E_CANON_HEX included, since spec-0.4.2), E_SLICE_AT_CELL, or at a job URL E_JOB_UNKNOWN (5.5); for not_covered, E_NAME_UNBOUND only; for error, none of E_JOB_UNKNOWN, E_SLICE_AT_CELL and E_NAME_UNBOUND. E_FOREIGN_UNAVAILABLE (spec-0.4.3) is an error envelope's only, with detail and HTTP 502. Since spec-0.5.0 not_covered may also carry E_NAMESPACE_SUSPENDED (a refused cross-mesh import, 9.9), never error; bad_request also E_SHORT_ID_AMBIGUOUS, and a call's E_KEY_NORMALISATION and E_KEY_ENCODING, never error. Codes absent from this list (E_ENVELOPE, E_DESCRIBE, E_UNROOTED_INPUT and the eight E_CLASS_* codes) are carried by no envelope."
    },
    "detail": {
      "description": "spec-0.4.3: with E_FOREIGN_UNAVAILABLE only, and required with it: what failed in reaching the foreign mesh (SPEC.md 5.5).",
      "enum": [
        "offline",
        "network",
        "dns",
        "tls",
        "timeout",
        "refused"
      ]
    },
    "fault": {
      "description": "For not_covered only (spec-0.4.0): the formula evaluation fault that gave the cell no value (SPEC.md 5.5, 15.11).",
      "enum": [
        "E_FORMULA_DIV_ZERO",
        "E_FORMULA_DOMAIN",
        "E_FORMULA_RANGE",
        "E_FORMULA_EMPTY",
        "E_FORMULA_ABSENT",
        "E_FORMULA_FUTURE",
        "E_FORMULA_KEY",
        "E_FORMULA_DISPATCH_KEY"
      ]
    },
    "resolved": {
      "description": "spec-0.5.0 (16.7): what a short call resolved: the full canonical call, each resolution, the alias snapshot's instant.",
      "type": "object",
      "required": [
        "call",
        "resolutions"
      ],
      "additionalProperties": false,
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1
        },
        "aliases_tx": {
          "$ref": "defs.schema.json#/$defs/instant"
        },
        "resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "kind",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "alias",
                  "default",
                  "lookup",
                  "method"
                ]
              },
              "asof": {
                "description": "spec-0.5.0 (Q10 a): for a lookup only, the instant its lookup cell was read as of.",
                "$ref": "defs.schema.json#/$defs/instant"
              }
            },
            "if": {
              "properties": {
                "kind": {
                  "const": "lookup"
                }
              }
            },
            "then": {
              "required": [
                "asof"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "asof"
                ]
              }
            }
          }
        }
      }
    },
    "shadows": {
      "description": "spec-0.5.0 (16.9): the class name this mesh binds to another hash than the reference class of that name.",
      "type": "object",
      "required": [
        "class",
        "reference"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "$ref": "defs.schema.json#/$defs/functionName"
        },
        "reference": {
          "$ref": "defs.schema.json#/$defs/hex64"
        }
      }
    }
  },
  "dependentRequired": {
    "reason": [
      "superseded_by"
    ]
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "ok"
        }
      },
      "required": [
        "receipt",
        "trust"
      ],
      "propertyNames": {
        "enum": [
          "outcome",
          "receipt",
          "trust",
          "superseded_by",
          "reason",
          "fn_hash",
          "resolved",
          "shadows"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "ok"
        }
      },
      "required": [
        "members",
        "slice"
      ],
      "propertyNames": {
        "enum": [
          "outcome",
          "members",
          "slice",
          "next",
          "fn_hash"
        ]
      },
      "description": "spec-0.4.2: a page of the slice endpoint (5.6)."
    },
    {
      "properties": {
        "outcome": {
          "const": "stale"
        }
      },
      "required": [
        "receipt",
        "trust",
        "age_seconds"
      ],
      "propertyNames": {
        "enum": [
          "outcome",
          "receipt",
          "trust",
          "age_seconds",
          "superseded_by",
          "reason",
          "fn_hash",
          "resolved",
          "shadows"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "not_covered"
        },
        "error": {
          "enum": [
            "E_NAME_UNBOUND",
            "E_NAMESPACE_SUSPENDED"
          ]
        }
      },
      "propertyNames": {
        "enum": [
          "outcome",
          "error",
          "fault",
          "fn_hash",
          "resolved",
          "shadows"
        ]
      },
      "not": {
        "required": [
          "error",
          "fault"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "unlicensed"
        }
      },
      "propertyNames": {
        "enum": [
          "outcome",
          "fn_hash",
          "resolved",
          "shadows"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "payment_required"
        }
      },
      "required": [
        "quote"
      ],
      "propertyNames": {
        "enum": [
          "outcome",
          "quote",
          "fn_hash",
          "resolved",
          "shadows"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "rate_limited"
        }
      },
      "required": [
        "retry_after_seconds"
      ],
      "propertyNames": {
        "enum": [
          "outcome",
          "retry_after_seconds",
          "fn_hash"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "error"
        },
        "error": {
          "not": {
            "enum": [
              "E_JOB_UNKNOWN",
              "E_SLICE_AT_CELL",
              "E_NAME_UNBOUND",
              "E_SHORT_ID_AMBIGUOUS",
              "E_NAMESPACE_SUSPENDED",
              "E_KEY_NORMALISATION",
              "E_KEY_ENCODING"
            ]
          }
        }
      },
      "required": [
        "error"
      ],
      "propertyNames": {
        "enum": [
          "outcome",
          "error",
          "fn_hash",
          "detail",
          "resolved",
          "shadows"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "error": {
                "const": "E_FOREIGN_UNAVAILABLE"
              }
            }
          },
          "then": {
            "required": [
              "detail"
            ]
          },
          "else": {
            "not": {
              "required": [
                "detail"
              ]
            }
          }
        }
      ]
    },
    {
      "properties": {
        "outcome": {
          "const": "bad_request"
        },
        "error": {
          "enum": [
            "E_PARSE_URI",
            "E_CANON_NAME",
            "E_CANON_ARG_NAME",
            "E_CANON_ARG_DUPLICATE",
            "E_CANON_ARG_ORDER",
            "E_CANON_PERCENT",
            "E_CANON_TYPE",
            "E_CANON_NUMBER",
            "E_CANON_DATE",
            "E_CANON_INSTANT",
            "E_CANON_STRING",
            "E_CANON_BLOB",
            "E_CANON_LIMIT",
            "E_ARG_UNKNOWN",
            "E_ARG_MISSING",
            "E_JOB_UNKNOWN",
            "E_CANON_HEX",
            "E_SLICE_AT_CELL",
            "E_SHORT_ID_AMBIGUOUS",
            "E_KEY_NORMALISATION",
            "E_KEY_ENCODING"
          ]
        }
      },
      "required": [
        "error"
      ],
      "propertyNames": {
        "enum": [
          "outcome",
          "error",
          "fn_hash"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "pending"
        }
      },
      "required": [
        "estimate_seconds",
        "job",
        "poll",
        "request"
      ],
      "propertyNames": {
        "enum": [
          "outcome",
          "estimate_seconds",
          "job",
          "poll",
          "request"
        ]
      }
    }
  ],
  "$defs": {
    "seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Written 0|[1-9][0-9]* (SPEC.md 5.5). JSON Schema cannot see that 30.0 is not written that way; the procedure in 5.5 checks it."
    }
  }
}
