{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datumesh.com/schemas/1/function.schema.json",
  "title": "Datumesh function descriptor",
  "description": "The object whose JCS SHA-256 is the function hash (SPEC.md section 7).",
  "type": "object",
  "required": [
    "code",
    "inputs",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "object",
      "required": [
        "body",
        "lang"
      ],
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string",
          "pattern": "^[^\u0000-\b\u000b-\u001f\u007f-\u009f]*$"
        },
        "lang": {
          "$ref": "defs.schema.json#/$defs/name"
        }
      }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4096,
      "items": {
        "$ref": "defs.schema.json#/$defs/functionName"
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "args",
        "returns"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "defs.schema.json#/$defs/argName"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "type",
              "valid"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "$ref": "defs.schema.json#/$defs/type"
              },
              "unit": {
                "$ref": "defs.schema.json#/$defs/unit"
              },
              "valid": {
                "type": "boolean"
              },
              "extent": {
                "description": "Optional (spec-0.4.0): the argument's declared extent (SPEC.md 7): values in the type's order, or a range for date and integer number arguments. The prose gives the codes for order, repetition and count (E_CANON_SET, E_CANON_LIMIT).",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "hi",
                      "lo"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "hi": {
                        "type": "string"
                      },
                      "lo": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "valid": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "type": {
                      "enum": [
                        "date",
                        "instant",
                        "string"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "number"
                    }
                  }
                },
                "then": {
                  "required": [
                    "unit"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "unit"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "boolean",
                        "blob"
                      ]
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "extent"
                    ]
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "extent"
                  ],
                  "properties": {
                    "extent": {
                      "type": "object"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "type": {
                      "enum": [
                        "date",
                        "number"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "extent"
                  ],
                  "properties": {
                    "type": {
                      "const": "number"
                    },
                    "extent": {
                      "type": "object"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "extent": {
                      "properties": {
                        "hi": {
                          "pattern": "^-?(0|[1-9][0-9]*)$"
                        },
                        "lo": {
                          "pattern": "^-?(0|[1-9][0-9]*)$"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "returns": {
          "description": "A type name, except number, which is {\"type\": \"number\", \"unit\": ...} (SPEC.md 7, D23).",
          "anyOf": [
            {
              "$ref": "defs.schema.json#/$defs/type",
              "not": {
                "const": "number"
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "unit"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "number"
                },
                "unit": {
                  "$ref": "defs.schema.json#/$defs/unit"
                }
              }
            }
          ]
        },
        "order": {
          "description": "Optional (spec-0.4.0): every argument name exactly once, the order positional arguments bind in (SPEC.md 7). Absent: labels only. The prose gives the codes: a missing, repeated or unknown name is E_CANON_SET.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
