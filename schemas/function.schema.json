{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datumesh.com/schemas/1/function.schema.json",
  "title": "Datumesh function descriptor",
  "description": "The object whose JCS SHA-256 is the function hash (SPEC.md section 7).",
  "type": "object",
  "required": ["code", "inputs", "signature"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "object",
      "required": ["body", "lang"],
      "additionalProperties": false,
      "properties": {
        "body": { "type": "string", "pattern": "^[^\u0000-\u0008\u000b-\u001f\u007f-\u009f]*$" },
        "lang": { "$ref": "defs.schema.json#/$defs/name" }
      }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4096,
      "items": { "$ref": "defs.schema.json#/$defs/functionName" }
    },
    "signature": {
      "type": "object",
      "required": ["args", "returns"],
      "additionalProperties": false,
      "properties": {
        "args": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "$ref": "defs.schema.json#/$defs/argName" },
          "additionalProperties": {
            "type": "object",
            "required": ["type", "valid"],
            "additionalProperties": false,
            "properties": {
              "type": { "$ref": "defs.schema.json#/$defs/type" },
              "valid": { "type": "boolean" }
            },
            "if": { "properties": { "valid": { "const": true } } },
            "then": { "properties": { "type": { "enum": ["date", "instant", "string"] } } }
          }
        },
        "returns": { "$ref": "defs.schema.json#/$defs/type" }
      }
    }
  }
}
