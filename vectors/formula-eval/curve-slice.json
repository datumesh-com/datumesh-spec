      "curve.example.net/df": {
        "bound": "2026-01-01T00:00:00.000000Z",
        "descriptor": {
          "code": {
            "body": "if tenor = 1 then 1 / (1 + curve.example.net/par_rate(tenor: tenor)) else (1 - curve.example.net/par_rate(tenor: tenor) * sum(curve.example.net/df(tenor: [1..tenor - 1]))) / (1 + curve.example.net/par_rate(tenor: tenor))\n",
            "lang": "formula"
          },
          "inputs": [
